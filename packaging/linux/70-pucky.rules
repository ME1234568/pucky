# Steam Controller 2026 over USB, Bluetooth HID, and the Puck.
KERNEL=="hidraw*", ATTRS{idVendor}=="28de", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*28DE:1303*", MODE="0660", TAG+="uaccess"

# Allow Pucky to create its virtual gamepad.
KERNEL=="uinput", SUBSYSTEM=="misc", MODE="0660", TAG+="uaccess", OPTIONS+="static_node=uinput"
